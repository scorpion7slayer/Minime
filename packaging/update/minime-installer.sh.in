#!/bin/sh
set -eu

VERSION="__VERSION__"
RELEASE_ROOT="https://github.com/scorpion7slayer/Minime/releases/download/v${VERSION}"
INSTALL_DIR="${CARGO_DIST_FORCE_INSTALL_DIR:-${MINIME_INSTALL_DIR:-}}"

fail() {
  printf '%s\n' "Minime update failed: $*" >&2
  exit 1
}

[ -n "$INSTALL_DIR" ] || fail "the install directory is missing"
[ -d "$INSTALL_DIR" ] || fail "the install directory does not exist"

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT HUP INT TERM

download_and_verify() {
  asset_name="$1"
  expected_sha="$2"
  archive_path="$TEMP_DIR/$asset_name"

  curl \
    --proto '=https' \
    --tlsv1.2 \
    --fail \
    --location \
    --silent \
    --show-error \
    "$RELEASE_ROOT/$asset_name" \
    --output "$archive_path"

  if command -v sha256sum >/dev/null 2>&1; then
    actual_sha="$(sha256sum "$archive_path" | awk '{print $1}')"
  else
    actual_sha="$(shasum -a 256 "$archive_path" | awk '{print $1}')"
  fi
  [ "$actual_sha" = "$expected_sha" ] || fail "the downloaded archive checksum does not match"
}

case "$(uname -s)" in
  Darwin)
    ASSET_NAME="Minime-${VERSION}-macos.zip"
    EXPECTED_SHA="__MACOS_SHA256__"
    case "$INSTALL_DIR" in
      */Contents/MacOS) ;;
      *) fail "Minime is not running from a standard application bundle" ;;
    esac

    APP_BUNDLE="$(cd "$INSTALL_DIR/../.." && pwd -P)"
    [ "$(basename "$APP_BUNDLE")" = "Minime.app" ] || fail "rename the app to Minime.app before updating"
    BACKUP_BUNDLE="${APP_BUNDLE}.minime-backup"
    [ ! -e "$BACKUP_BUNDLE" ] || fail "a previous update backup still exists"

    download_and_verify "$ASSET_NAME" "$EXPECTED_SHA"
    mkdir "$TEMP_DIR/extracted"
    ditto -x -k "$TEMP_DIR/$ASSET_NAME" "$TEMP_DIR/extracted"
    NEW_BUNDLE="$TEMP_DIR/extracted/Minime.app"
    [ -d "$NEW_BUNDLE" ] || fail "the archive does not contain Minime.app"

    codesign --verify --deep --strict --verbose=2 "$NEW_BUNDLE"
    SIGNATURE_DETAILS="$(codesign --display --verbose=4 "$NEW_BUNDLE" 2>&1)"
    printf '%s\n' "$SIGNATURE_DETAILS" | grep -q 'Authority=Developer ID Application:' \
      || fail "the update is not signed with Developer ID"
    printf '%s\n' "$SIGNATURE_DETAILS" | grep -q 'TeamIdentifier=3849ST995Q' \
      || fail "the update was not signed by the Minime developer team"
    [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$NEW_BUNDLE/Contents/Info.plist")" = "io.github.scorpion7slayer.minime" ] \
      || fail "the update has the wrong application identifier"
    spctl --assess --type execute --verbose=4 "$NEW_BUNDLE"

    mv "$APP_BUNDLE" "$BACKUP_BUNDLE"
    if ! mv "$NEW_BUNDLE" "$APP_BUNDLE"; then
      mv "$BACKUP_BUNDLE" "$APP_BUNDLE"
      fail "the new application could not be installed"
    fi
    ;;

  Linux)
    ASSET_NAME="Minime-${VERSION}-linux.tar.gz"
    EXPECTED_SHA="__LINUX_SHA256__"
    CURRENT_BINARY="$INSTALL_DIR/minime"
    BACKUP_BINARY="${CURRENT_BINARY}.minime-backup"
    [ -x "$CURRENT_BINARY" ] || fail "the installed Minime executable was not found"
    [ ! -e "$BACKUP_BINARY" ] || fail "a previous update backup still exists"

    download_and_verify "$ASSET_NAME" "$EXPECTED_SHA"
    mkdir "$TEMP_DIR/extracted"
    tar -xzf "$TEMP_DIR/$ASSET_NAME" -C "$TEMP_DIR/extracted"
    NEW_BINARY="$TEMP_DIR/extracted/minime"
    [ -f "$NEW_BINARY" ] || fail "the archive does not contain the Minime executable"

    mv "$CURRENT_BINARY" "$BACKUP_BINARY"
    if ! install -m 755 "$NEW_BINARY" "$CURRENT_BINARY"; then
      mv "$BACKUP_BINARY" "$CURRENT_BINARY"
      fail "the new executable could not be installed"
    fi
    ;;

  *)
    fail "this operating system is not supported by the shell updater"
    ;;
esac

printf '%s\n' "Minime ${VERSION} is installed."
